{
  "name": "sistem-nilai-zero-trust",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Nilai - Tugas Praktikum Zero Trust Security",
  "scripts": {
    "setup": "node database/setup.js",
    "gateway": "node gateway/index.js",
    "nilai": "node service-nilai/index.js",
    "transkrip": "node service-transkrip/index.js",
