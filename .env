# ===== Port =====
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

# ===== Database (default Laragon: root tanpa password) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistem_nilai

# ===== Rahasia (ganti jika mau) =====
JWT_SECRET=ganti-dengan-rahasia-jwt-yang-panjang-123456
GATEWAY_SECRET=rahasia-gateway-antar-service-987654

# ===== Kredensial Service Nilai (untuk POST /auth/service) =====
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=rahasia-client-service-nilai

# ===== Jam akses (24 jam). Ubah untuk demo, mis. 0 dan 24 = selalu boleh =====
ACCESS_HOUR_START=0
ACCESS_HOUR_END=24
